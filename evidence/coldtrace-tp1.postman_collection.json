{
  "info": {
    "name": "ColdTrace TP1 local vertical flow",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:18080"
    },
    {
      "key": "gatewayKey",
      "value": "coldtrace-local-demo-key"
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (pm.info.requestName === 'Ingest deviation') { pm.collectionVariables.set('batchKey', pm.variables.replaceIn('{{$guid}}')); pm.collectionVariables.set('recordedAt', new Date().toISOString()); }"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Authenticate local fixture",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/v1/authentication/sign-in",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"tp1-local-one@coldtrace.example\",\n  \"password\": \"Local-TP1-only-2026\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.collectionVariables.set('token', pm.response.json().token);"
            ]
          }
        }
      ]
    },
    {
      "name": "Resolve owning organization",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/session/context",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ]
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Ingest deviation",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/v1/telemetry/batches",
        "header": [
          {
            "key": "X-Gateway-Key",
            "value": "{{gatewayKey}}"
          },
          {
            "key": "Idempotency-Key",
            "value": "{{batchKey}}"
          },
          {
            "key": "X-Correlation-Id",
            "value": "tp1-postman"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"gatewayUuid\": \"11111111-1111-1111-1111-111111111111\",\n  \"readings\": [\n    {\n      \"deviceUuid\": \"22222222-2222-2222-2222-222222222222\",\n      \"sequenceNumber\": 9200000,\n      \"recordedAt\": \"{{recordedAt}}\",\n      \"temperature\": 12,\n      \"humidity\": 60\n    }\n  ]\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 202', () => pm.response.to.have.status(202));"
            ]
          }
        }
      ]
    },
    {
      "name": "Repeat batch without duplication",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/v1/telemetry/batches",
        "header": [
          {
            "key": "X-Gateway-Key",
            "value": "{{gatewayKey}}"
          },
          {
            "key": "Idempotency-Key",
            "value": "{{batchKey}}"
          },
          {
            "key": "X-Correlation-Id",
            "value": "tp1-postman"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"gatewayUuid\": \"11111111-1111-1111-1111-111111111111\",\n  \"readings\": [\n    {\n      \"deviceUuid\": \"22222222-2222-2222-2222-222222222222\",\n      \"sequenceNumber\": 9200000,\n      \"recordedAt\": \"{{recordedAt}}\",\n      \"temperature\": 12,\n      \"humidity\": 60\n    }\n  ]\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 202', () => pm.response.to.have.status(202));",
              "pm.test('duplicate', () => pm.expect(pm.response.json().duplicated).to.eql(1));"
            ]
          }
        }
      ]
    },
    {
      "name": "Reject invalid gateway key",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/v1/telemetry/batches",
        "header": [
          {
            "key": "X-Gateway-Key",
            "value": "wrong-key"
          },
          {
            "key": "Idempotency-Key",
            "value": "{{batchKey}}"
          },
          {
            "key": "X-Correlation-Id",
            "value": "tp1-postman"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"gatewayUuid\": \"11111111-1111-1111-1111-111111111111\",\n  \"readings\": [\n    {\n      \"deviceUuid\": \"22222222-2222-2222-2222-222222222222\",\n      \"sequenceNumber\": 9200000,\n      \"recordedAt\": \"{{recordedAt}}\",\n      \"temperature\": 12,\n      \"humidity\": 60\n    }\n  ]\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 401', () => pm.response.to.have.status(401));"
            ]
          }
        }
      ]
    },
    {
      "name": "Read latest asset state",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/assets/1/state",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ]
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Read projected states",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/assets/states?page=0&size=10",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ]
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Read generated alerts",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/alerts",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ]
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    }
  ]
}
